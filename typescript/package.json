{
  "name": "humblebundle-downloader-ts",
  "version": "0.1.0",
  "description": "Bun-based TypeScript port of humblebundle-downloader.",
  "type": "module",
  "bin": {
    "hbd": "bin/hbd-node",
    "hbd-bun": "bin/hbd"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "bun src/cli/index.ts",
    "hbd": "bun src/cli/index.ts",
    "lint": "bunx eslint .",
    "prepublishOnly": "bun run build",
    "start": "bun run cli",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "bun-types": "^1.1.39",
    "eslint": "^8.57.0",
    "typescript": "^5.7.2"
  }
}

{
  "name": "humblebundle-downloader-ts",
  "version": "0.1.0",
  "description": "Bun-based TypeScript port of humblebundle-downloader.",
  "type": "module",
  "bin": {
    "hbd": "bin/hbd-node",
    "hbd-bun": "bin/hbd"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "bun src/cli/index.ts",
    "hbd": "bun src/cli/index.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false bunx eslint .",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "lint:staged": "lint-staged",
    "prepublishOnly": "bun run build",
    "start": "bun run cli",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "yauzl": "^2.10.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/yauzl": "^2.10.2",
    "@types/yazl": "^2.4.6",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "bun-types": "^1.1.39",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,json,md}": "bunx prettier --write"
  }
}
